{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability Radar Signal v2",
  "description": "能力雷达单条信号的结构化格式。v2 增加跨周身份：series_id 让同一主题的连续观测成为可计算的时间序列。",
  "type": "object",
  "required": ["id", "series_id", "date", "track", "category", "summary", "source", "confidence", "status"],
  "properties": {
    "id": { "type": "string", "description": "格式：YYYY-MM-DD-短横线命名，属于这一次观测" },
    "series_id": { "type": "string", "description": "跨周稳定身份，格式：track.主题.指标，如 procurement.finance.llm-security-gateway。同一主题的连续观测必须使用相同 series_id" },
    "date": { "type": "string", "description": "信号录入日期 YYYY-MM-DD" },
    "track": {
      "type": "string",
      "enum": ["talent", "procurement", "ecosystem"],
      "description": "talent=招聘市场，procurement=采购市场，ecosystem=开源/社区/报告生态"
    },
    "category": { "type": "string" },
    "skill": { "type": "string" },
    "industry": { "type": "string" },
    "region": { "type": "string" },
    "summary": { "type": "string", "description": "一句话说清这条信号" },
    "metric": { "type": "string" },
    "value": { "type": ["string", "number"] },
    "unit": { "type": "string" },
    "change": { "type": "string" },
    "period": {
      "type": "object",
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" }
      },
      "description": "数据口径覆盖的统计区间"
    },
    "previous_signal_id": { "type": ["string", "null"], "description": "同一 series 的上一条信号 id；series 首条填 null" },
    "source": {
      "type": "object",
      "required": ["name", "url", "date", "type"],
      "properties": {
        "name": { "type": "string", "description": "原始发布方，不是转述方" },
        "url": { "type": ["string", "null"], "description": "原始链接。找不到填 null，且 confidence 不得为 A" },
        "date": { "type": "string" },
        "type": { "type": "string", "enum": ["primary", "research", "media", "community"] }
      }
    },
    "archive": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["repo", "wayback"] },
        "path": { "type": "string", "description": "repo 内路径（如 evidence/...）或 Wayback 地址" }
      },
      "description": "A 级证据必须带存档：原件转存 repo 或提交 Wayback，把可核验变成永久可核验"
    },
    "confidence": {
      "type": "string",
      "enum": ["A", "B", "C"],
      "description": "A=一手来源可点击核验且有存档；B=权威二手；C=待核实"
    },
    "status": {
      "type": "string",
      "enum": ["new", "strengthening", "stable", "weakening"]
    },
    "status_reason": { "type": "string", "description": "动量判断依据，跨周对比时必填" },
    "note": { "type": "string" }
  }
}
