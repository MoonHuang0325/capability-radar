{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability Radar Signal",
  "description": "能力雷达单条信号的结构化格式。一条信号 = 一个可核验的市场事实 + 来源 + 证据等级 + 动量状态。",
  "type": "object",
  "required": ["id", "date", "track", "category", "summary", "source", "confidence", "status"],
  "properties": {
    "id": { "type": "string", "description": "格式：YYYY-MM-DD-短横线命名" },
    "date": { "type": "string", "description": "信号录入日期 YYYY-MM-DD" },
    "track": {
      "type": "string",
      "enum": ["talent", "procurement", "ecosystem"],
      "description": "talent=招聘市场，procurement=采购市场，ecosystem=开源/社区/报告生态"
    },
    "category": { "type": "string", "description": "如 agent-engineering / ai-evaluation / llm-security-procurement" },
    "skill": { "type": "string", "description": "个人侧信号填写，相关技能名" },
    "industry": { "type": "string", "description": "企业侧信号填写，如 金融/制造/零售/医疗" },
    "region": { "type": "string", "description": "如 China / US / Global / 具体省份" },
    "summary": { "type": "string", "description": "一句话说清这条信号" },
    "metric": { "type": "string", "description": "指标名，如 新发岗位占比 / 中标金额" },
    "value": { "type": ["string", "number"], "description": "指标值" },
    "unit": { "type": "string", "description": "如 % / 元 / 个" },
    "change": { "type": "string", "description": "同口径变化，如 +310% YoY" },
    "source": {
      "type": "object",
      "required": ["name", "url", "date", "type"],
      "properties": {
        "name": { "type": "string", "description": "原始发布方，不是转述方" },
        "url": { "type": ["string", "null"], "description": "原始链接。找不到原始链接填 null，且 confidence 不得为 A" },
        "date": { "type": "string", "description": "原始发布日期" },
        "type": { "type": "string", "enum": ["primary", "research", "media", "community"] }
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["A", "B", "C"],
      "description": "A=一手原始来源可点击核验；B=权威二手（官方数据的媒体转述）；C=社区信号或未溯源，待核实"
    },
    "status": {
      "type": "string",
      "enum": ["new", "strengthening", "stable", "weakening"],
      "description": "动量状态，跨周对比后更新"
    },
    "note": { "type": "string", "description": "口径说明、待办（如 待补原始链接）" }
  }
}
